# The values `compose.isolation-lab.yaml` needs, with placeholders in place of values.
#
# Copy this file to `deployment/lab/.env.lab` and fill it in. The real file is gitignored
# (`.gitignore`: `deployment/lab/.env.lab`), and the values below are the three that matter —
# they are what makes the lab a *different* stack from the one on 8080 rather than a second
# front door onto it.
#
# Nothing here is a secret anyone should keep: the lab is disposable and reproducible from
# `compose.isolation-lab.yaml`, and both passwords are throwaway values for a throwaway stack.
# They are still passwords, so they live on disk and out of history.

# The absolute path to this repository, as the host sees it. It is what the stack bind-mounts
# read-only at `/home/frappe/frappe-bench/apps/smartprocess_logistics`, so the lab runs the code
# in your working tree — uncommitted changes included — and never a copy.
#
# Windows (note the forward slashes Git Bash and Docker Desktop both accept):
#   SMARTPROCESS_LOGISTICS_APP_PATH=C:/Users/<you>/smartprocess_logistics
# Linux or macOS:
#   SMARTPROCESS_LOGISTICS_APP_PATH=/home/<you>/smartprocess_logistics
SMARTPROCESS_LOGISTICS_APP_PATH=<absolute path to this repository>

# The MariaDB root password for the lab's own database container. Its database is not published
# and not reachable from the `erpnext` stack's network, so this value protects nothing but the
# lab — which is the point: a password here must never be one that is used anywhere else.
LAB_DB_ROOT_PASSWORD=<a throwaway password>

# The Administrator password for the lab site, used by the checks that log in through the front
# end (`verify_http_round_trip.py` reads it from this variable at run time).
LAB_SITE_ADMIN_PASSWORD=<a throwaway password>
