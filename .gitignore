# Python bytecode and build output
*.pyc
__pycache__/
*.egg-info/
dist/
build/

# Tool caches
.pytest_cache/
.ruff_cache/
.mypy_cache/

# An isolated virtual environment, used to run the database-free tests on a machine that is
# not a bench. It is disposable: recreate it with `python -m venv .venv`.
.venv/
.venv-*/

# Local environment files. Never commit real values.
.env
.env.*
!.env.example

# Node tooling
node_modules/

# Claude Code personal settings for this project. The shared parts of `.claude/`
# (skills, agents) are committed; this file is one operator's own overrides and
# can hold local values that do not belong in history.
.claude/settings.local.json

# Operating system noise
.DS_Store
Thumbs.db

# The isolation lab's throwaway credentials. The stack these belong to is disposable and
# reproducible from `deployment/lab/compose.isolation-lab.yaml`, but a password is still a
# password: it lives on disk and out of history.
deployment/lab/.env.lab

# Local preview helpers. They carry absolute host paths and a port belonging to another project,
# and they are scaffolding for a browser pane, not part of the app: kept on disk, out of history.
.claude/launch.json
.claude/pane_8080.py
.claude/proof_proxy.py
.claude/sp_proxy.py
